+// SetTrackerCallbacks installs optional lifecycle hooks for the native Android
+// layer. Callbacks run after the tracker has been added/removed from the
+// manager and must not block: they are invoked on the connection goroutine.
+func (m *Manager) SetTrackerCallbacks(onJoin func(Tracker), onLeave func(*TrackerInfo)) {
+	m.callbackMu.Lock()
+	m.onJoin = onJoin
+	m.onLeave = onLeave
+	m.callbackMu.Unlock()
+}
+
 func (m *Manager) Join(c Tracker) {
 	m.connections.Store(c.ID(), c)
+	m.callbackMu.RLock()
+	callback := m.onJoin
+	m.callbackMu.RUnlock()
+	if callback != nil {
+		callback(c)
+	}
 }
 
 func (m *Manager) Leave(c Tracker) {
 	m.connections.Delete(c.ID())
+	m.callbackMu.RLock()
+	callback := m.onLeave
+	m.callbackMu.RUnlock()
+	if callback != nil {
+		callback(c.Info())
+	}
 }
 
 func (m *Manager) Get(id string) (c Tracker) {
