@@ -0,0 +1,31 @@
+package statistic
+
+import "testing"
+
+func TestManagerLifecycleCallbacks(t *testing.T) {
+	manager := &Manager{}
+	tracker := &tcpTracker{TrackerInfo: &TrackerInfo{}}
+	var joined Tracker
+	var left *TrackerInfo
+
+	manager.SetTrackerCallbacks(
+		func(c Tracker) { joined = c },
+		func(info *TrackerInfo) { left = info },
+	)
+
+	manager.Join(tracker)
+	if joined != tracker {
+		t.Fatal("join callback did not receive the tracker")
+	}
+	if manager.Get(tracker.ID()) != tracker {
+		t.Fatal("tracker was not stored by Join")
+	}
+
+	manager.Leave(tracker)
+	if left != tracker.Info() {
+		t.Fatal("leave callback did not receive the tracker info")
+	}
+	if manager.Get(tracker.ID()) != nil {
+		t.Fatal("tracker was not removed by Leave")
+	}
+}
