+		findProcessMode != process.FindProcessOff &&
+		isRejectProxy(metadata, proxy) {
+		// Strict mode normally defers owner lookup until a rule needs process data. Rejected flows
+		// can close before the native history sampler resolves their owner, so check them while live.
