 	return
 }
 
+func isRejectProxy(metadata *C.Metadata, proxy C.Proxy) bool {
+	for adapter := proxy; adapter != nil; adapter = adapter.Unwrap(metadata, false) {
+		if adapter.Type() == C.Reject || adapter.Type() == C.RejectDrop {
+			return true
+		}
+	}
+	return false
+}
