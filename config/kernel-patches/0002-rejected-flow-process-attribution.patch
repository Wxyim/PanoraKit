@@ -30,9 +30,20 @@ type PackageNameResolver func(metadata *C.Metadata) (string, error)
 // never change type traits because it's used in CMFA
 var DefaultPackageNameResolver PackageNameResolver
 
+// DefaultPackageNameResolverWithForce resolves a package name and can request a fresh owner lookup.
+var DefaultPackageNameResolverWithForce func(metadata *C.Metadata, force bool) (string, error)
+
 func FindPackageName(metadata *C.Metadata) (string, error) {
 	if resolver := DefaultPackageNameResolver; resolver != nil {
 		return resolver(metadata)
 	}
 	return "", ErrPlatformNotSupport
 }
+
+// FindPackageNameWithForce requests a fresh owner lookup when the platform supports it.
+func FindPackageNameWithForce(metadata *C.Metadata) (string, error) {
+	if resolver := DefaultPackageNameResolverWithForce; resolver != nil {
+		return resolver(metadata, true)
+	}
+	return "", ErrPlatformNotSupport
+}
